#!/bin/bash
set -euo pipefail

REPO="openai/codex"
# The release ships a self-describing package (codex-package.json) whose layout
# codex resolves relative to /proc/self/exe: bin/codex plus its helper binaries
# (codex-code-mode-host), codex-path/rg, and codex-resources/{bwrap,zsh}.
# Unpack it whole and symlink only the entrypoint onto PATH.
PREFIX="$HOME/.local/share/codex"
DEST="$HOME/.local/bin/codex"

TAG=$(gh release list --repo "$REPO" --limit 50 --exclude-drafts --exclude-pre-releases |
	awk -F'\t' '$2 == "Latest" {print $3}')

if [[ -z $TAG ]]; then
	echo "Error: no stable release found" >&2
	exit 1
fi

echo "Latest stable release: $TAG"

ASSETS=$(gh release view "$TAG" --repo "$REPO" --json assets --jq '.assets[].name')

ASSET=""
for libc in gnu musl; do
	candidate="codex-package-x86_64-unknown-linux-${libc}.tar.gz"
	if grep -Fxq "$candidate" <<<"$ASSETS"; then
		ASSET="$candidate"
		break
	fi
done

if [[ -z $ASSET ]]; then
	echo "Error: no linux x86_64 package asset (gnu or musl) found in $TAG" >&2
	exit 1
fi

SUMS="codex-package_SHA256SUMS"

if ! grep -Fxq "$SUMS" <<<"$ASSETS"; then
	echo "Error: $SUMS not found in $TAG" >&2
	exit 1
fi

WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT

echo "Downloading $ASSET..."
gh release download "$TAG" --repo "$REPO" --pattern "$ASSET" --pattern "$SUMS" --dir "$WORKDIR"

# $SUMS covers every platform, so check only our asset's line: a bare --check
# would fail on the archives we did not download. This is an integrity check
# against the release manifest, not a signature check.
echo "Verifying checksum..."
awk -v asset="$ASSET" '$2 == asset' "$WORKDIR/$SUMS" >"$WORKDIR/$SUMS.filtered"

if [[ $(wc -l <"$WORKDIR/$SUMS.filtered") -ne 1 ]]; then
	echo "Error: expected exactly one checksum entry for $ASSET in $SUMS" >&2
	exit 1
fi

(cd "$WORKDIR" && sha256sum --strict --check "$SUMS.filtered")

echo "Extracting..."
mkdir "$WORKDIR/pkg"
tar -xzf "$WORKDIR/$ASSET" -C "$WORKDIR/pkg"

for required in codex-package.json bin/codex; do
	if [[ ! -e $WORKDIR/pkg/$required ]]; then
		echo "Error: $required missing from $ASSET" >&2
		echo "Archive contents:"
		find "$WORKDIR/pkg" -mindepth 1
		exit 1
	fi
done

# Swap by rename so a running codex keeps its old package directory.
mkdir -p "$(dirname "$PREFIX")"
rm -rf "$PREFIX.new" "$PREFIX.old"
mv "$WORKDIR/pkg" "$PREFIX.new"
if [[ -e $PREFIX ]]; then
	mv "$PREFIX" "$PREFIX.old"
fi
mv "$PREFIX.new" "$PREFIX"
rm -rf "$PREFIX.old"

mkdir -p "$(dirname "$DEST")"
ln -sfn "$PREFIX/bin/codex" "$DEST"

echo "Installed codex $TAG to $PREFIX (linked as $DEST)"

exit 0
