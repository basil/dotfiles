#!/bin/sh -eux

reset_codex_home() {
	[[ -d "$1" ]] || return 0

	rm -fv "$1"/*cache.json
	rm -fv "$1"/history*
	rm -fv "$1"/*.lock
	rm -fv "$1"/.*.lock
	rm -fv "$1"/packages/app-server-daemon/auto-update-version.*
	rm -fv "$1"/session_index*
	rm -fv "$1"/*.sqlite*
	rm -rfv "$1"/app-server-control
	rm -rfv "$1"/app-server-daemon
	rm -rfv "$1"/cache
	rm -rfv "$1"/editor
	rm -rfv "$1"/rules
	rm -rfv "$1"/sessions
	rm -rfv "$1"/shell_snapshots
	rm -rfv "$1"/thread-writer-locks
	rm -rfv "$1"/tmp
	rm -rfv "$1"/tui-thread-reference-capabilities
}

reset_codex_home ~/.codex
reset_codex_home ~/.isomux/codex-home
